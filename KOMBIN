def pdf_rapor_olustur():
    """PDF rapor oluştur (C4)"""
    if not kombin_sonuclari or not MATPLOTLIB_AVAILABLE:
        messagebox.showwarning("Uyarı",
                               "Dışa aktarılacak veri yok veya Matplotlib yüklü değil.")
        return

    dosya_yolu = filedialog.asksaveasfilename(
        defaultextension=".pdf",
        filetypes=[("PDF", "*.pdf")],
        title="PDF Rapor Kaydet")
    if not dosya_yolu:
        return

    try:
        with PdfPages(dosya_yolu) as pdf:
            # === SAYFA 1: ÖZET ===
            fig1 = Figure(figsize=(11, 8.5), facecolor='white')
            ax1 = fig1.add_subplot(111)
            ax1.axis('off')

            tarih = datetime.now().strftime("%Y-%m-%d %H:%M")
            ax1.text(0.5, 0.95, "Kombin Analiz Raporu",
                     transform=ax1.transAxes, fontsize=24,
                     fontweight='bold', ha='center', color='#2c3e50')
            ax1.text(0.5, 0.90, f"Oluşturulma: {tarih}",
                     transform=ax1.transAxes, fontsize=12,
                     ha='center', color='#7f8c8d')

            sepet_boyutlari = satis_verisi.groupby('Siparis_No')['Urun_Adi'].count()
            ozet_text = (
                f"Toplam Sipariş: {toplam_siparis_sayisi}\n"
                f"Benzersiz Ürün: {len(benzersiz_urunler)}\n"
                f"Toplam Kombin Çifti: {len(kombin_sonuclari)}\n"
                f"Ortalama Sepet Büyüklüğü: {sepet_boyutlari.mean():.1f} ürün\n\n"
                f"En Çok Satan 10 Kombin:\n")

            for i, k in enumerate(kombin_sonuclari[:10]):
                ozet_text += (
                    f"  {i+1}. {k['urun_cifti']} -> "
                    f"{k['frekans']} kez (Güven: %{k['guven_max']:.1f})\n")

            ax1.text(0.1, 0.80, ozet_text, transform=ax1.transAxes,
                     fontsize=11, va='top', family='monospace', color='#2c3e50')
            pdf.savefig(fig1)

            # === SAYFA 2: BAR GRAFİK ===
            fig2 = Figure(figsize=(11, 8.5), facecolor='white')
            ax2 = fig2.add_subplot(111)
            en_iyiler = kombin_sonuclari[:10]
            etiketler = [k["urun_cifti"] for k in en_iyiler]
            degerler = [k["frekans"] for k in en_iyiler]
            y_pos = np.arange(len(etiketler))
            renk_palette = mcm.RdYlBu_r(np.linspace(0.2, 0.8, len(degerler)))
            ax2.barh(y_pos, degerler, color=renk_palette)
            ax2.set_yticks(y_pos)
            ax2.set_yticklabels(etiketler, fontsize=9)
            ax2.invert_yaxis()
            ax2.set_title("En Çok Birlikte Satılan 10 Ürün Kombini",
                          fontsize=14, fontweight='bold', pad=20)
            fig2.tight_layout()
            pdf.savefig(fig2)

            # === SAYFA 3: ISI HARİTASI ===
            en_populer = list(urun_sayac_global.most_common(8))
            urunler = [u[0] for u in en_populer]
            n = len(urunler)
            matris = np.zeros((n, n))
            for k in kombin_sonuclari:
                if k["urun1"] in urunler and k["urun2"] in urunler:
                    i = urunler.index(k["urun1"])
                    j = urunler.index(k["urun2"])
                    matris[i][j] = k["frekans"]
                    matris[j][i] = k["frekans"]

            fig3 = Figure(figsize=(11, 8.5), facecolor='white')
            ax3 = fig3.add_subplot(111)
            kisa_isimler = [u[:12] for u in urunler]
            im = ax3.imshow(matris, cmap='YlOrRd', aspect='auto')
            ax3.set_xticks(np.arange(n))
            ax3.set_yticks(np.arange(n))
            ax3.set_xticklabels(kisa_isimler, rotation=45, ha="right", fontsize=8)
            ax3.set_yticklabels(kisa_isimler, fontsize=8)
            for i in range(n):
                for j in range(n):
                    val = int(matris[i, j])
                    if val > 0:
                        ax3.text(j, i, str(val), ha='center', va='center',
                                 fontsize=9, fontweight='bold')
            fig3.colorbar(im, ax=ax3, shrink=0.8)
            ax3.set_title("Ürün Birliktelik Isı Haritası",
                          fontsize=14, fontweight='bold', pad=20)
            fig3.tight_layout()
            pdf.savefig(fig3)

        messagebox.showinfo("Başarılı", f"PDF rapor kaydedildi:\n{dosya_yolu}")
    except Exception as e:
        messagebox.showerror("Hata", f"PDF oluşturma hatası: {e}")


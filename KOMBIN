        return
    _temizle_grafik_alani()

    en_populer = list(urun_sayac_global.most_common(8))
    urunler = [u[0] for u in en_populer]
    n = len(urunler)

    matris = np.zeros((n, n))
    for k in kombin_sonuclari:
        if k["urun1"] in urunler and k["urun2"] in urunler:
            i = urunler.index(k["urun1"])
            j = urunler.index(k["urun2"])
            matris[i][j] = k["frekans"]
            matris[j][i] = k["frekans"]

    fig = Figure(figsize=(10, 6), facecolor=tema_renk("grafik_bg"))
    ax = fig.add_subplot(111)
    ax.set_facecolor(tema_renk("grafik_bg"))

    im = ax.imshow(matris, cmap='YlOrRd', aspect='auto')

    kisa_isimler = [u[:MAX_LABEL_LENGTH] + "…" if len(u) > MAX_LABEL_LENGTH else u for u in urunler]
    ax.set_xticks(np.arange(n))
    ax.set_yticks(np.arange(n))
    ax.set_xticklabels(kisa_isimler, rotation=45, ha="right",
                       fontsize=8, color=tema_renk("yazi"))
    ax.set_yticklabels(kisa_isimler, fontsize=8, color=tema_renk("yazi"))

    for i in range(n):
        for j in range(n):
            val = int(matris[i, j])
            if val > 0:
                text_color = "white" if val > matris.max() * 0.5 else "black"
                ax.text(j, i, str(val), ha="center", va="center",
                        fontsize=9, color=text_color, fontweight="bold")


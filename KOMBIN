    for _ in range(500):
        siparis_no += 1
        sepet_boyutu = np.random.randint(1, 5)
        zar = np.random.rand()

        sepet = []
        if zar < 0.3:
            sepet.extend(kalip1[:np.random.randint(2, 4)])
        elif zar < 0.5:
            sepet.extend(kalip2)
        elif zar < 0.7:
            sepet.extend(kalip3[:np.random.randint(2, 4)])
        else:
            sepet.extend(np.random.choice(urun_havuzu, sepet_boyutu, replace=False))

        sepet = list(set(sepet))
        for urun in sepet:
            fiyat = np.random.randint(150, 800)
            siparisler.append({"Siparis_No": siparis_no, "Urun_Adi": urun, "Fiyat": fiyat})

    global satis_verisi
    satis_verisi = pd.DataFrame(siparisler)
    root.after(0, analiz_calistir)

def analiz_calistir():
    global satis_verisi, kombin_sonuclari, uclu_kombin_sonuclari
    global benzersiz_urunler, toplam_siparis_sayisi, urun_sayac_global

    if satis_verisi.empty:
        return

    root.after(0, lambda: set_status("Kombinler analiz ediliyor (Sepet Analizi)...", "yellow"))

    benzersiz_urunler = sorted(satis_verisi['Urun_Adi'].unique().tolist())
    toplam_siparis_sayisi = satis_verisi['Siparis_No'].nunique()

    siparis_gruplari = satis_verisi.groupby('Siparis_No')['Urun_Adi'].apply(list)

    # --- İkili kombinasyonlar ---
    ikili_sayac = Counter()
    urun_sayac = Counter()

    for sepet in siparis_gruplari:
        sepet = sorted(list(set(sepet)))
        for urun in sepet:
            urun_sayac[urun] += 1
        if len(sepet) > 1:
            for k in itertools.combinations(sepet, 2):
                ikili_sayac[k] += 1

    urun_sayac_global = urun_sayac

    kombin_sonuclari = []
    for (u1, u2), frekans in ikili_sayac.most_common():
        guven_u1_u2 = (frekans / urun_sayac[u1]) * 100
        guven_u2_u1 = (frekans / urun_sayac[u2]) * 100
        destek = (frekans / toplam_siparis_sayisi) * 100

        kombin_sonuclari.append({
            "urun_cifti": f"{u1} + {u2}",
            "urun1": u1, "urun2": u2,
            "frekans": frekans,
            "destek_yuzde": destek,
            "guven_max": max(guven_u1_u2, guven_u2_u1)
        })

    # --- Üçlü kombinasyonlar (C1) ---
    uclu_sayac = Counter()
    for sepet in siparis_gruplari:
        sepet = sorted(list(set(sepet)))
        if len(sepet) >= 3:
            for k in itertools.combinations(sepet, 3):
                uclu_sayac[k] += 1

    uclu_kombin_sonuclari = []
    for (u1, u2, u3), frekans in uclu_sayac.most_common(30):
        destek = (frekans / toplam_siparis_sayisi) * 100
        uclu_kombin_sonuclari.append({
            "urun_uclusu": f"{u1} + {u2} + {u3}",
            "urun1": u1, "urun2": u2, "urun3": u3,
            "frekans": frekans, "destek_yuzde": destek
        })

    # Veritabanına kaydet (C5)
    analiz_kaydet()

    root.after(0, guncelle_arayuz)
    root.after(0, lambda: set_status("Analiz tamamlandı.", "green"))

def kendi_verimi_yukle():
    dosya_yolu = filedialog.askopenfilename(
        filetypes=[("Excel ve CSV", "*.xlsx *.xls *.csv")])
    if not dosya_yolu:
        return

    try:
        if dosya_yolu.endswith('.csv'):
            df = pd.read_csv(dosya_yolu)
        else:
            df = pd.read_excel(dosya_yolu)

        beklenen_sutunlar = ['Siparis_No', 'Urun_Adi']
        if not all(col in df.columns for col in beklenen_sutunlar):
            messagebox.showerror(
                "Hata",
                "Yüklenen dosyada 'Siparis_No' ve 'Urun_Adi' sütunları bulunmak zorundadır.")
            return

        global satis_verisi
        satis_verisi = df
        threading.Thread(target=analiz_calistir, daemon=True).start()
        messagebox.showinfo("Başarılı",
                            f"{len(df)} satır veri başarıyla yüklendi ve analize başlandı.")
    except Exception as e:
        messagebox.showerror("Hata", f"Dosya okunurken bir hata oluştu: {e}")

# --- KPI SAYAÇ ANİMASYONU (A1) ---
def animasyonlu_sayac(label, hedef, adim=0, toplam_adim=20,
                      prefix="", suffix="", ondalik=False):
    if adim > toplam_adim:
        if ondalik:
            label.configure(text=f"{prefix}{hedef:.1f}{suffix}")
        else:
            label.configure(text=f"{prefix}{int(hedef)}{suffix}")
        return

    oran = adim / toplam_adim
    # Ease-out cubic
    oran = 1 - (1 - oran) ** 3
    mevcut = hedef * oran

    if ondalik:
        label.configure(text=f"{prefix}{mevcut:.1f}{suffix}")
    else:
        label.configure(text=f"{prefix}{int(mevcut)}{suffix}")

    root.after(30, lambda: animasyonlu_sayac(
        label, hedef, adim + 1, toplam_adim, prefix, suffix, ondalik))


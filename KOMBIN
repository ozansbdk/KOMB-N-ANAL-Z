def veritabani_baslat():
    try:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute('''CREATE TABLE IF NOT EXISTS analiz_gecmisi (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tarih TEXT,
            toplam_siparis INTEGER,
            toplam_urun INTEGER,
            toplam_kombin INTEGER,
            ort_sepet REAL,
            en_iyi_kombin TEXT,
            en_iyi_frekans INTEGER
        )''')
        c.execute('''CREATE TABLE IF NOT EXISTS kombin_detay (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            analiz_id INTEGER,
            urun1 TEXT,
            urun2 TEXT,
            frekans INTEGER,
            destek REAL,
            guven REAL,
            FOREIGN KEY(analiz_id) REFERENCES analiz_gecmisi(id)
        )''')
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"Veritabanı başlatma hatası: {e}")

def analiz_kaydet():
    if not kombin_sonuclari:
        return
    try:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        sepet_boyutlari = satis_verisi.groupby('Siparis_No')['Urun_Adi'].count()
        ort_sepet = float(sepet_boyutlari.mean()) if not sepet_boyutlari.empty else 0

        c.execute(
            '''INSERT INTO analiz_gecmisi
               (tarih, toplam_siparis, toplam_urun, toplam_kombin, ort_sepet, en_iyi_kombin, en_iyi_frekans)
               VALUES (?, ?, ?, ?, ?, ?, ?)''',
            (datetime.now().strftime("%Y-%m-%d %H:%M"),
             toplam_siparis_sayisi, len(benzersiz_urunler),
             len(kombin_sonuclari), round(ort_sepet, 2),
             kombin_sonuclari[0]["urun_cifti"] if kombin_sonuclari else "",
             kombin_sonuclari[0]["frekans"] if kombin_sonuclari else 0))

        analiz_id = c.lastrowid
        for k in kombin_sonuclari[:50]:
            c.execute(
                '''INSERT INTO kombin_detay (analiz_id, urun1, urun2, frekans, destek, guven)
                   VALUES (?, ?, ?, ?, ?, ?)''',
                (analiz_id, k['urun1'], k['urun2'], k['frekans'],
                 k['destek_yuzde'], k['guven_max']))
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"Veritabanı kayıt hatası: {e}")

def gecmis_analizleri_getir():
    try:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT * FROM analiz_gecmisi ORDER BY id DESC LIMIT 10")
        sonuclar = c.fetchall()
        conn.close()
        return sonuclar
    except Exception:
        return []

# --- GEMINI API ENTEGRASYONU ---
def gemini_istek_gonder(prompt):
    if not GEMINI_API_KEY or GEMINI_API_KEY == "":
        return "Lütfen kod içerisine Gemini API Anahtarınızı girin."

    url = f"{GEMINI_API_URL}?key={GEMINI_API_KEY}"
    payload = {"contents": [{"parts": [{"text": prompt}]}]}

    try:
        response = requests.post(
            url, headers={'Content-Type': 'application/json'},
            json=payload, timeout=40)
        if response.status_code == 200:
            return response.json()["candidates"][0]["content"]["parts"][0]["text"]
        else:
            return f"API Hatası: {response.status_code}"
    except Exception as e:
        return f"Bağlantı Hatası: {e}"


        sonuc = gemini_istek_gonder(prompt)
        sohbet_gecmisi.append({"rol": "kullanici", "mesaj": kullanici_mesaj})
        sohbet_gecmisi.append({"rol": "ai", "mesaj": sonuc})

        root.after(0, lambda: sohbet_son_mesaji_guncelle(f"🤖 AI: {sonuc}"))

    threading.Thread(target=yanit_al, daemon=True).start()

def sohbet_ekrana_yaz(mesaj):
    chat_display.configure(state="normal")
    chat_display.insert("end", mesaj + "\n\n")
    chat_display.configure(state="disabled")
    chat_display.see("end")

def sohbet_son_mesaji_guncelle(yeni_mesaj):
    chat_display.configure(state="normal")
    content = chat_display.get("1.0", "end-1c")
    lines = content.split('\n')
    # Sondaki boş satırları ve "düşünüyor" mesajını kaldır
    while lines and lines[-1].strip() == '':
        lines.pop()
    if lines and "düşünüyor" in lines[-1]:
        lines.pop()
        while lines and lines[-1].strip() == '':
            lines.pop()

    new_content = '\n'.join(lines) + '\n\n' + yeni_mesaj + '\n\n'
    chat_display.delete("1.0", "end")
    chat_display.insert("1.0", new_content)
    chat_display.configure(state="disabled")
    chat_display.see("end")


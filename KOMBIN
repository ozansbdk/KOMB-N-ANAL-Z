def hover_efekti_ekle(widget, normal_renk, hover_renk):
    def giris(e):
        widget.configure(fg_color=hover_renk)
    def cikis(e):
        widget.configure(fg_color=normal_renk)
    widget.bind("<Enter>", giris)
    widget.bind("<Leave>", cikis)

def kart_hover_ekle(kart, border_normal="#2f3640", border_hover="#3498db"):
    def giris(e):
        kart.configure(border_color=border_hover, border_width=3)
    def cikis(e):
        kart.configure(border_color=border_normal, border_width=2)
    kart.bind("<Enter>", giris)
    kart.bind("<Leave>", cikis)


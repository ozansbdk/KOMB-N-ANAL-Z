def yapay_zeka_kampanya_onerisi_al():
    if not kombin_sonuclari:
        messagebox.showwarning("Uyarı", "Önce verilerin yüklenmesi ve analiz edilmesi gerekiyor.")
        return
        
    ai_textbox.configure(state="normal")
    ai_textbox.delete("0.0", "end")
    ai_textbox.insert("0.0", "🤖 Pazarlama Uzmanı AI verilerinizi inceliyor, kampanya ve çapraz satış fikirleri üretiyor...\n(Bu işlem birkaç saniye sürebilir)")
    ai_textbox.configure(state="disabled")
    
    def analiz_yap():
        ilk_5 = "\n".join([f"- {k['urun_cifti']} (Beraber alınma: {k['frekans']} kez)" for k in kombin_sonuclari[:5]])
        prompt = f"""Bir e-ticaret sitesinin verilerini analiz ediyoruz. Müşteriler en çok şu ürünleri birlikte alıyor:
        
{ilk_5}

Sen uzman bir e-ticaret büyüme ve pazarlama müdürüsün. Lütfen bu verilere bakarak:
1. Neden bu ürünler birlikte alınıyor olabilir? Kısa psikolojik/kullanım analizi.
2. Bu ikililer için sepette çapraz satış (cross-sell) pop-up'ı çıksak müşteriye nasıl bir mesaj göstermeliyiz? (Örn: 'Bunu alanlar şunu da aldı, ikisini al %10 indirim kazan' gibi yaratıcı kurgular).
3. Bu ürünleri satmak için nasıl bir e-posta veya SMS kampanyası düzenlemeliyiz?

Lütfen direkt konuya gir ve madde madde, profesyonel ama pazarlama diliyle yaz."""

        sonuc = gemini_istek_gonder(prompt)
        root.after(0, lambda: ai_textbox.configure(state="normal"))
        root.after(0, lambda: ai_textbox.delete("0.0", "end"))
        root.after(0, lambda: ai_textbox.insert("0.0", sonuc))
        root.after(0, lambda: ai_textbox.configure(state="disabled"))
        
    threading.Thread(target=analiz_yap, daemon=True).start()

def csv_disa_aktar():
    if not kombin_sonuclari:
        messagebox.showwarning("Uyarı", "Dışa aktarılacak veri yok.")
        return
    dosya_yolu = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV", "*.csv")], title="Sonuçları Kaydet")
    if dosya_yolu:
        try:
            with open(dosya_yolu, mode='w', newline='', encoding='utf-8-sig') as f:
                writer = csv.writer(f, delimiter=';')
                writer.writerow(["Urun_1", "Urun_2", "Birlikte_Satis_Adedi", "Tüm_Siparislerde_Bulunma_Orani(%)", "Guven_Skoru(%)"])
                for k in kombin_sonuclari:
                    writer.writerow([k['urun1'], k['urun2'], k['frekans'], round(k['destek_yuzde'],2), round(k['guven_max'],2)])
            messagebox.showinfo("Başarılı", f"Kombin sonuçları kaydedildi:\n{dosya_yolu}")
        except Exception as e:
            messagebox.showerror("Hata", f"Kayıt hatası: {e}")


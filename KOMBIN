# --- GEMINI API ENTEGRASYONU ---
def gemini_istek_gonder(prompt):
    if not GEMINI_API_KEY or GEMINI_API_KEY == "":
        return "Lütfen kod içerisine Gemini API Anahtarınızı girin."
        
    url = f"{GEMINI_API_URL}?key={GEMINI_API_KEY}"
    payload = {"contents": [{"parts": [{"text": prompt}]}]}
        
    try:
        response = requests.post(url, headers={'Content-Type': 'application/json'}, json=payload, timeout=40)
        if response.status_code == 200:
            return response.json()["candidates"][0]["content"]["parts"][0]["text"]
        else:
            return f"API Hatası: {response.status_code}"
    except Exception as e:
        return f"Bağlantı Hatası: {e}"

# --- VERİ İŞLEME VE KOMBİN ANALİZİ (Sepet Analizi - Association Rules) ---
def ornek_veri_olustur():
    """Uygulama boş kalmasın diye sanal bir e-ticaret satış verisi oluşturur"""
    root.after(0, lambda: set_status("Örnek veriler oluşturuluyor...", "yellow"))
    
    urun_havuzu = [
        "Siyah Kot Pantolon", "Beyaz Basic Tişört", "Deri Kemer", "Spor Ayakkabı",
        "Güneş Gözlüğü", "Kapüşonlu Sweatshirt", "Oversize Gömlek", "Keten Şort",
        "Kışlık Bere", "Desenli Çorap"
    ]
    
    # Mantıklı kombin kalıpları (Yapay ağırlıklandırma)
    kalip1 = ["Siyah Kot Pantolon", "Beyaz Basic Tişört", "Deri Kemer"] # Sık alınır
    kalip2 = ["Spor Ayakkabı", "Desenli Çorap"] # Sık alınır
    kalip3 = ["Oversize Gömlek", "Keten Şort", "Güneş Gözlüğü"] # Yaz kombini
    
    siparisler = []
    siparis_no = 1000
    
    for _ in range(500): # 500 adet sipariş oluştur
        siparis_no += 1
        sepet_boyutu = np.random.randint(1, 5)
        zar = np.random.rand()
        
        sepet = []
        if zar < 0.3: sepet.extend(kalip1[:np.random.randint(2,4)])
        elif zar < 0.5: sepet.extend(kalip2)
        elif zar < 0.7: sepet.extend(kalip3[:np.random.randint(2,4)])
        else: sepet.extend(np.random.choice(urun_havuzu, sepet_boyutu, replace=False))
        
        # Tekrarlayanları temizle
        sepet = list(set(sepet))
        for urun in sepet:
            fiyat = np.random.randint(150, 800)
            siparisler.append({"Siparis_No": siparis_no, "Urun_Adi": urun, "Fiyat": fiyat})
            
    global satis_verisi
    satis_verisi = pd.DataFrame(siparisler)
    root.after(0, analiz_calistir)

def analiz_calistir():
    global satis_verisi, kombin_sonuclari, benzersiz_urunler, toplam_siparis_sayisi
    
    if satis_verisi.empty: return
    
    root.after(0, lambda: set_status("Kombinler analiz ediliyor (Sepet Analizi)...", "yellow"))
    
    # 1. Benzersiz ürünleri ve toplam sipariş sayısını bul
    benzersiz_urunler = sorted(satis_verisi['Urun_Adi'].unique().tolist())
    toplam_siparis_sayisi = satis_verisi['Siparis_No'].nunique()
    
    # 2. Her siparişteki ürünleri liste halinde grupla
    siparis_gruplari = satis_verisi.groupby('Siparis_No')['Urun_Adi'].apply(list)
    
    # 3. İkili kombinasyonları say
    ikili_sayac = Counter()
    urun_sayac = Counter()
    
    for sepet in siparis_gruplari:
        sepet = sorted(list(set(sepet))) # Aynı üründen 2 tane aldıysa tek say
        for urun in sepet:
            urun_sayac[urun] += 1
            
        if len(sepet) > 1:
            kombinler = itertools.combinations(sepet, 2)
            for k in kombinler:
                ikili_sayac[k] += 1
                
    # 4. Sonuçları listeye çevir ve formatla
    kombin_sonuclari = []
    for (u1, u2), frekans in ikili_sayac.most_common():
        # Güven (Confidence): u1 alanların yüzde kaçı u2 de almış?
        guven_u1_u2 = (frekans / urun_sayac[u1]) * 100
        guven_u2_u1 = (frekans / urun_sayac[u2]) * 100
        
        # Destek (Support): Tüm siparişlerin yüzde kaçında bu ikili var?
        destek = (frekans / toplam_siparis_sayisi) * 100
        
        kombin_sonuclari.append({
            "urun_cifti": f"{u1} + {u2}",
            "urun1": u1,
            "urun2": u2,
            "frekans": frekans,
            "destek_yuzde": destek,
            "guven_max": max(guven_u1_u2, guven_u2_u1) # İki yönlü güvenden yüksek olan
        })
        
    root.after(0, guncelle_arayuz)
    root.after(0, lambda: set_status("Analiz tamamlandı.", "green"))

def kendi_verimi_yukle():
    dosya_yolu = filedialog.askopenfilename(filetypes=[("Excel ve CSV", "*.xlsx *.xls *.csv")])
    if not dosya_yolu: return
    
    try:
        if dosya_yolu.endswith('.csv'):
            df = pd.read_csv(dosya_yolu)
        else:
            df = pd.read_excel(dosya_yolu)
            
        # Sütun kontrolü
        beklenen_sutunlar = ['Siparis_No', 'Urun_Adi']
        if not all(col in df.columns for col in beklenen_sutunlar):
            messagebox.showerror("Hata", "Yüklenen dosyada 'Siparis_No' ve 'Urun_Adi' sütunları bulunmak zorundadır.")
            return
            
        global satis_verisi
        satis_verisi = df
        threading.Thread(target=analiz_calistir, daemon=True).start()
        messagebox.showinfo("Başarılı", f"{len(df)} satır veri başarıyla yüklendi ve analize başlandı.")
    except Exception as e:
        messagebox.showerror("Hata", f"Dosya okunurken bir hata oluştu: {e}")


def grafik_ciz_network():
    if not kombin_sonuclari or not MATPLOTLIB_AVAILABLE:
        return
    _temizle_grafik_alani()

    fig = Figure(figsize=(10, 6), facecolor=tema_renk("grafik_bg"))
    ax = fig.add_subplot(111)
    ax.set_facecolor(tema_renk("grafik_bg"))

    en_populer = list(urun_sayac_global.most_common(8))
    urunler = [u[0] for u in en_populer]
    urun_agirlik = {u[0]: u[1] for u in en_populer}

    n = len(urunler)
    angles = np.linspace(0, 2 * np.pi, n, endpoint=False)
    positions = {u: (np.cos(a) * 3, np.sin(a) * 3)
                 for u, a in zip(urunler, angles)}

    max_frekans = max(
        (k["frekans"] for k in kombin_sonuclari[:20]
         if k["urun1"] in urunler and k["urun2"] in urunler),
        default=1)

    for k in kombin_sonuclari[:30]:
        if k["urun1"] in urunler and k["urun2"] in urunler:
            x1, y1 = positions[k["urun1"]]
            x2, y2 = positions[k["urun2"]]
            kalinlik = max(1, (k["frekans"] / max_frekans) * 8)
            alfa = max(0.3, k["frekans"] / max_frekans)
            ax.plot([x1, x2], [y1, y2], color="#3498db",
                    linewidth=kalinlik, alpha=alfa, zorder=1)
            mx, my = (x1 + x2) / 2, (y1 + y2) / 2
            ax.text(mx, my, str(k["frekans"]), ha='center', va='center',
                    fontsize=7, color=tema_renk("yazi"), alpha=0.8,
                    bbox=dict(boxstyle='round,pad=0.2',
                              facecolor=tema_renk("grafik_bg"),
                              alpha=0.8, edgecolor='none'))

    max_agirlik = max(urun_agirlik.values()) if urun_agirlik else 1
    node_renkleri = mcm.Set2(np.linspace(0, 1, n))

    for idx, urun in enumerate(urunler):
        x, y = positions[urun]
        boyut = 300 + (urun_agirlik[urun] / max_agirlik) * 700
        ax.scatter(x, y, s=boyut, color=node_renkleri[idx],
                   edgecolors='white', linewidth=2, zorder=2)
        kisa_isim = urun[:MAX_LABEL_LENGTH] + "…" if len(urun) > MAX_LABEL_LENGTH else urun
        ax.text(x, y - 0.5, kisa_isim, ha='center', va='top',
                fontsize=8, color=tema_renk("yazi"), fontweight='bold')

    ax.set_xlim(-5, 5)
    ax.set_ylim(-5, 5)
    ax.axis('off')
    ax.set_title("Ürün İlişki Ağ Grafiği",
                 color=tema_renk("yazi"), pad=20,
                 fontsize=14, fontweight='bold')
    fig.tight_layout()

    canvas = FigureCanvasTkAgg(fig, master=chart_display_container)
    canvas.draw()
    canvas.get_tk_widget().pack(fill="both", expand=True)


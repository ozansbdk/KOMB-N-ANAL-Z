# --- AKILLI ARAÇLAR: DİNAMİK BUNDLE OLUŞTURUCU (Özellik #3) ---
def bundle_olustur():
    """En çok birlikte satılan kombinlerden otomatik paket önerileri oluşturur."""
    if not kombin_sonuclari:
        messagebox.showwarning("Uyarı", "Önce verilerin yüklenmesi gerekiyor.")
        return

    for w in bundle_icerik_frame.winfo_children():
        w.destroy()

    # Header
    ctk.CTkLabel(bundle_icerik_frame, text="⏳ Bundle paketleri oluşturuluyor...",
                 font=("Segoe UI", 14), text_color="#f39c12").pack(pady=10)

    def bundle_hesapla():
        # İkili paketler
        ikili_paketler = []
        # Ürün meta bilgilerini tek seferde hesapla
        urun_fiyat_ort = {}
        urun_kategori = {}
        urun_renk = {}
        agg_dict = {}
        if 'Fiyat' in satis_verisi.columns:
            agg_dict['Fiyat'] = 'mean'
        if 'Kategori' in satis_verisi.columns:
            agg_dict['Kategori'] = 'first'
        if 'Renk' in satis_verisi.columns:
            agg_dict['Renk'] = 'first'
        if agg_dict:
            urun_agg = satis_verisi.groupby('Urun_Adi').agg(agg_dict)
            if 'Fiyat' in urun_agg.columns:
                urun_fiyat_ort = urun_agg['Fiyat'].to_dict()
            if 'Kategori' in urun_agg.columns:
                urun_kategori = urun_agg['Kategori'].to_dict()
            if 'Renk' in urun_agg.columns:
                urun_renk = urun_agg['Renk'].to_dict()

        for k in kombin_sonuclari[:5]:
            f1 = urun_fiyat_ort.get(k['urun1'], 0)
            f2 = urun_fiyat_ort.get(k['urun2'], 0)
            toplam_fiyat = f1 + f2
            ikili_paketler.append({
                "urunler": [k['urun1'], k['urun2']],
                "frekans": k['frekans'],
                "destek": k['destek_yuzde'],
                "toplam_fiyat": toplam_fiyat,
                "kategoriler": [urun_kategori.get(k['urun1'], ''), urun_kategori.get(k['urun2'], '')],
                "renkler": [urun_renk.get(k['urun1'], ''), urun_renk.get(k['urun2'], '')],
            })

        # Üçlü paketler
        uclu_paketler = []
        for k in uclu_kombin_sonuclari[:3]:
            toplam_fiyat = sum(urun_fiyat_ort.get(u, 0) for u in [k['urun1'], k['urun2'], k['urun3']])
            uclu_paketler.append({
                "urunler": [k['urun1'], k['urun2'], k['urun3']],
                "frekans": k['frekans'],
                "destek": k['destek_yuzde'],
                "toplam_fiyat": toplam_fiyat,
                "kategoriler": [urun_kategori.get(u, '') for u in [k['urun1'], k['urun2'], k['urun3']]],
                "renkler": [urun_renk.get(u, '') for u in [k['urun1'], k['urun2'], k['urun3']]],
            })

        # AI ile paket isimleri ve pazarlama metni oluştur
        paket_listesi = ""
        for i, p in enumerate(ikili_paketler):
            kat_str = " | ".join(filter(None, p.get("kategoriler", [])))
            renk_str = " & ".join(filter(None, p.get("renkler", [])))
            paket_listesi += (f"İkili Paket {i+1}: {' + '.join(p['urunler'])} "
                              f"(Frekans: {p['frekans']}, Fiyat: {p['toplam_fiyat']:.0f} TL, "
                              f"Kategoriler: {kat_str}, Renkler: {renk_str})\n")
        for i, p in enumerate(uclu_paketler):
            kat_str = " | ".join(filter(None, p.get("kategoriler", [])))
            renk_str = " & ".join(filter(None, p.get("renkler", [])))
            paket_listesi += (f"Üçlü Paket {i+1}: {' + '.join(p['urunler'])} "
                              f"(Frekans: {p['frekans']}, Fiyat: {p['toplam_fiyat']:.0f} TL, "
                              f"Kategoriler: {kat_str}, Renkler: {renk_str})\n")

        # İndirim istatistikleri
        indirim_bilgisi = ""
        if 'Indirim_Orani' in satis_verisi.columns:
            ort_indirim = satis_verisi['Indirim_Orani'].mean()
            indirim_bilgisi = f"\nMevcut ortalama indirim oranı: %{ort_indirim:.1f}"

        prompt = f"""Sen uzman bir e-ticaret ürün yöneticisi ve pazarlama kreatifisin.
Aşağıdaki gerçek satış verilerinden oluşturulan ürün paketleri için:
{paket_listesi}{indirim_bilgisi}

Her paket için:
1. Yaratıcı ve çekici bir paket ismi (Türkçe, kısa)
2. Önerilen indirim oranı (% olarak) ve gerekçesi
3. E-ticaret sitesi için 1 cümlelik pazarlama metni
4. Hedef müşteri profili

Ayrıca genel strateji olarak:
- "3 Al 2 Öde" vs "Paket İndirimi" hangisi daha etkili olur?
- Haftanın kombini konsepti nasıl uygulanmalı?
Format: Her paket için ayrı ayrı, madde madde yaz."""

        ai_sonuc = gemini_istek_gonder(prompt)

        def goster():
            for w in bundle_icerik_frame.winfo_children():
                w.destroy()

            # Paket kartları
            ctk.CTkLabel(bundle_icerik_frame, text="🏷️ Otomatik Oluşturulan Bundle Paketleri",
                         font=("Segoe UI", 18, "bold"),
                         text_color=tema_renk("yazi")).pack(anchor="w", padx=10, pady=(10, 5))

            paket_grid = ctk.CTkFrame(bundle_icerik_frame, fg_color="transparent")
            paket_grid.pack(fill="x", padx=5, pady=5)
            for i in range(3):
                paket_grid.grid_columnconfigure(i, weight=1)

            renkler_b = ["#e74c3c", "#3498db", "#2ecc71", "#f39c12", "#9b59b6"]
            tum_paketler = ikili_paketler + uclu_paketler

            for idx, paket in enumerate(tum_paketler[:6]):
                kart = ctk.CTkFrame(paket_grid, fg_color=tema_renk("kart"),
                                    corner_radius=12, border_width=2,
                                    border_color=renkler_b[idx % 5])
                kart.grid(row=idx // 3, column=idx % 3, padx=8, pady=8, sticky="nsew")
                kart_hover_ekle(kart, tema_renk("border"), renkler_b[idx % 5])

                tip = "İkili" if len(paket["urunler"]) == 2 else "Üçlü"
                ctk.CTkLabel(kart, text=f"📦 {tip} Paket #{idx+1}",
                             font=("Segoe UI", 13, "bold"),
                             text_color=renkler_b[idx % 5]).pack(padx=10, pady=(10, 2))

                for urun in paket["urunler"]:
                    ctk.CTkLabel(kart, text=f"  • {urun}",
                                 font=("Segoe UI", 11),
                                 text_color=tema_renk("yazi")).pack(anchor="w", padx=15)

                bilgi_f = ctk.CTkFrame(kart, fg_color="transparent")
                bilgi_f.pack(fill="x", padx=10, pady=(5, 2))
                ctk.CTkLabel(bilgi_f, text=f"🔥 {paket['frekans']}x satış",
                             font=("Segoe UI", 10),
                             text_color=tema_renk("yazi2")).pack(side="left")
                if paket["toplam_fiyat"] > 0:
                    ctk.CTkLabel(bilgi_f, text=f"💰 {paket['toplam_fiyat']:.0f} TL",
                                 font=("Segoe UI", 10, "bold"),
                                 text_color="#2ecc71").pack(side="right")

                ctk.CTkLabel(kart, text=f"Destek: %{paket['destek']:.1f}",
                             font=("Segoe UI", 10),
                             text_color=tema_renk("yazi3")).pack(pady=(0, 10))

            # AI önerisi
            ai_kart = ctk.CTkFrame(bundle_icerik_frame, fg_color=tema_renk("kart"),
                                   corner_radius=12, border_width=2,
                                   border_color="#f39c12")
            ai_kart.pack(fill="x", padx=10, pady=(10, 5))
            ctk.CTkLabel(ai_kart, text="🤖 AI Paket Stratejisi",
                         font=("Segoe UI", 16, "bold"),
                         text_color="#f39c12").pack(anchor="w", padx=15, pady=(10, 5))
            ctk.CTkLabel(ai_kart, text=ai_sonuc,
                         font=("Segoe UI", 12),
                         text_color=tema_renk("yazi2"),
                         wraplength=800, justify="left").pack(fill="x", padx=15, pady=(5, 15))

        root.after(0, goster)


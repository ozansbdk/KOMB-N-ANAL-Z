def urune_gore_kombin_getir():
    secilen = urun_secim_var.get()
    if not secilen:
        return

    for w in liste_icerik_frame.winfo_children():
        w.destroy()

    ilgili_kombinler = [k for k in kombin_sonuclari
                        if k["urun1"] == secilen or k["urun2"] == secilen]

    # Filtreleme (C2)
    min_frekans_val = int(min_frekans_slider.get())
    siralama = siralama_var.get()

    ilgili_kombinler = [k for k in ilgili_kombinler
                        if k["frekans"] >= min_frekans_val]

    if siralama == "Güven Skoru":
        ilgili_kombinler.sort(key=lambda x: x["guven_max"], reverse=True)
    elif siralama == "Destek Oranı":
        ilgili_kombinler.sort(key=lambda x: x["destek_yuzde"], reverse=True)

    if not ilgili_kombinler:
        ctk.CTkLabel(liste_icerik_frame,
                     text=f"'{secilen}' için birlikte alınma verisi bulunamadı.",
                     text_color=tema_renk("yazi3")).pack(pady=20)
        return

    for idx, k in enumerate(ilgili_kombinler[:15]):
        satir = ctk.CTkFrame(
            liste_icerik_frame,
            fg_color=tema_renk("satir_cift") if idx % 2 == 0 else tema_renk("satir_tek"),
            height=45, corner_radius=6)
        satir.pack(fill="x", pady=2)
        satir.pack_propagate(False)

        diger_urun = k["urun2"] if k["urun1"] == secilen else k["urun1"]

        ctk.CTkLabel(satir, text=f"🛍️ {diger_urun}",
                     font=("Segoe UI", 14, "bold"),
                     text_color=tema_renk("yazi")).pack(side="left", padx=15)
        ctk.CTkLabel(satir, text=f"Satış: {k['frekans']}",
                     font=("Segoe UI", 13),
                     text_color=tema_renk("yazi2")).pack(side="right", padx=15)
        ctk.CTkLabel(satir, text=f"Güven: %{k['guven_max']:.1f}",
                     font=("Segoe UI", 13, "bold"),
                     text_color="#2ecc71").pack(side="right", padx=10)
        ctk.CTkLabel(satir, text=f"Destek: %{k['destek_yuzde']:.1f}",
                     font=("Segoe UI", 13),
                     text_color="#3498db").pack(side="right", padx=10)


    def uyari_analiz():
        # Geçmiş analizleri al
        gecmis = gecmis_analizleri_getir()

        uyarilar = []
        if gecmis and len(gecmis) > 1:
            onceki = gecmis[1]  # Bir önceki analiz
            simdiki_siparis = toplam_siparis_sayisi
            onceki_siparis = onceki[2]

            if onceki_siparis > 0:
                degisim = ((simdiki_siparis - onceki_siparis) / onceki_siparis) * 100
                if degisim < -10:
                    uyarilar.append(("🔴", f"Sipariş sayısı %{abs(degisim):.1f} düştü! (Önceki: {onceki_siparis}, Şimdi: {simdiki_siparis})"))
                elif degisim > 10:
                    uyarilar.append(("🟢", f"Sipariş sayısı %{degisim:.1f} arttı! (Önceki: {onceki_siparis}, Şimdi: {simdiki_siparis})"))

            onceki_kombin = onceki[4]
            simdiki_kombin = len(kombin_sonuclari)
            if onceki_kombin > 0:
                k_degisim = ((simdiki_kombin - onceki_kombin) / onceki_kombin) * 100
                if abs(k_degisim) > 15:
                    renk = "🟢" if k_degisim > 0 else "🔴"
                    uyarilar.append((renk, f"Kombin çifti sayısı %{abs(k_degisim):.1f} {'arttı' if k_degisim > 0 else 'düştü'}!"))

        # Stok uyarıları - düşük destekli ama yüksek frekansli kombinler

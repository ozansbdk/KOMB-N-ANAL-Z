def grafik_ciz_radar():
    if not kombin_sonuclari or not MATPLOTLIB_AVAILABLE or not benzersiz_urunler:
        return
    _temizle_grafik_alani()

    en_populer = list(urun_sayac_global.most_common(5))

    fig = Figure(figsize=(8, 6), facecolor=tema_renk("grafik_bg"))
    ax = fig.add_subplot(111, polar=True)
    ax.set_facecolor(tema_renk("grafik_bg"))

    kategoriler = ['Satış\nAdedi', 'Ort.\nGüven', 'Ort.\nDestek',
                   'Kombin\nSayısı', 'Popülerlik']
    N = len(kategoriler)
    angles = np.linspace(0, 2 * np.pi, N, endpoint=False).tolist()
    angles += angles[:1]

    renkler_r = mcm.Set1(np.linspace(0, 1, len(en_populer)))

    for idx, (urun, adet) in enumerate(en_populer):
        ilgili = [k for k in kombin_sonuclari
                  if k["urun1"] == urun or k["urun2"] == urun]
        ort_guven = np.mean([k["guven_max"] for k in ilgili]) if ilgili else 0
        ort_destek = np.mean([k["destek_yuzde"] for k in ilgili]) if ilgili else 0
        kombin_sayisi = len(ilgili)

        max_adet = en_populer[0][1] if en_populer[0][1] else 1
        values = [
            adet / max_adet,
            ort_guven / 100,
            min(ort_destek / 10, 1),
            min(kombin_sayisi / 20, 1),
            adet / max_adet
        ]
        values += values[:1]

        kisa = urun[:10]
        ax.plot(angles, values, color=renkler_r[idx], linewidth=2, label=kisa)
        ax.fill(angles, values, color=renkler_r[idx], alpha=0.1)

    ax.set_xticks(angles[:-1])
    ax.set_xticklabels(kategoriler, fontsize=8, color=tema_renk("yazi"))
    ax.tick_params(axis='y', colors=tema_renk("yazi3"))
    ax.spines['polar'].set_color(tema_renk("grafik_cizgi"))
    ax.grid(color=tema_renk("grafik_cizgi"), alpha=0.3)

    legend = ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1), fontsize=8)
    for text in legend.get_texts():
        text.set_color(tema_renk("yazi"))
    legend.get_frame().set_facecolor(tema_renk("grafik_bg"))
    legend.get_frame().set_edgecolor(tema_renk("grafik_cizgi"))

    ax.set_title("Ürün Performans Radar Grafiği",
                 color=tema_renk("yazi"), pad=30,
                 fontsize=14, fontweight='bold')
    fig.tight_layout()

    canvas = FigureCanvasTkAgg(fig, master=chart_display_container)
    canvas.draw()
    canvas.get_tk_widget().pack(fill="both", expand=True)

